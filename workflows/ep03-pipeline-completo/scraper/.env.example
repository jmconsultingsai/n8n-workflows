# .env.example — Copy this file to .env and fill in your values.
# Never commit .env to version control — it contains secrets.

# ── Datafordeler Authentication ───────────────────────────────────────────────
# Get your credentials at: https://datafordeler.dk/
# My IT-systems -> Create new IT-system -> Subscribe to "CVR" service
#
# Option A — OAuth2 (recommended): token auto-refreshes every 60 minutes.
DATAFORDELER_OAUTH_CLIENT_ID=your_client_id_here
DATAFORDELER_OAUTH_CLIENT_SECRET=your_client_secret_here
#
# Option B — API Key (simpler, but does not auto-refresh):
# DATAFORDELER_API_KEY=your_api_key_here
#
# Note: set either OAuth OR API Key, not both. OAuth takes priority.

# ── Datafordeler API endpoints (defaults are correct — change only if needed) ─
# CVR_GRAPHQL_URL=https://graphql.datafordeler.dk/CVR/v2
# CVR_GRAPHQL_SCHEMA_URL=https://graphql.datafordeler.dk/CVR/v2/schema

# ── Scraper filters ───────────────────────────────────────────────────────────
# Companies with fewer than MIN_EMPLOYEES or more than MAX_EMPLOYEES are filtered out.
MIN_EMPLOYEES=5
MAX_EMPLOYEES=200

# Output CSV file name (written to the same directory as scrape_cvr.py)
OUTPUT_FILE=leads.csv

# ── Google Sheets (for sync_leads.py) ────────────────────────────────────────
# The spreadsheet ID is the long string in your Google Sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
SPREADSHEET_ID=your_google_sheets_id_here

# Path to your Google Cloud service account JSON key file.
# Use a relative path (relative to sync_leads.py) or an absolute path.
# Download from: Google Cloud Console -> IAM -> Service Accounts -> Keys -> Add Key -> JSON
SERVICE_ACCOUNT_FILE=credentials.json

# ── Optional: Google Maps Sheet (WF4 integration) ────────────────────────────
# Only needed if you enable the read_gmaps() source in sync_leads.py.
# GMAPS_SPREADSHEET_ID=your_gmaps_sheet_id_here

# ── Optional: CVR CSV path override ──────────────────────────────────────────
# By default sync_leads.py looks for leads.csv in the same folder as the script.
# Override here if your scraper writes to a different location.
# CVR_CSV=leads.csv
